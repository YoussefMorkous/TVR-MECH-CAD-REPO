* text=auto
*.py text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.bat text eol=crlf
*.[sS][lL][dD][pP][rR][tT] filter=lfs diff=lfs merge=lfs -text lockable
*.[sS][lL][dD][aA][sS][mM] filter=lfs diff=lfs merge=lfs -text lockable
*.[sS][lL][dD][dD][rR][wW] filter=lfs diff=lfs merge=lfs -text lockable
*.[sS][tT][eE][pP] filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][pP] filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][lL] filter=lfs diff=lfs merge=lfs -text
*.[xX][lL][sS][xX] filter=lfs diff=lfs merge=lfs -text
cad/.edit-lock -text lockable
